<?xml version="1.0" encoding="UTF-8"?>
<!--
  Portal DZI — wewnętrzny portal kafelkowy departamentu DZI.
  Autor: Maciej Myśliwiec, 2026.
-->
<!--
  Szablon web.config dla witryny arimr-app.zszik.pl (katalog frontendu statycznego).
  Wymaga: URL Rewrite + ARR (z włączonym proxy), HTTP_X_FORWARDED_FOR w Allowed
  Server Variables oraz - dla Windows Auth - modułu PortalAuthUserModule.dll
  w katalogu bin\ i puli .NET v4.0 Integrated (INSTRUKCJA-MODUL-WINDOWS-AUTH.md).
-->
<configuration>
    <system.webServer>
        <modules>
            <!-- Wpisuje login po uwierzytelnieniu (PostAuthenticateRequest) i usuwa X-Auth-Dept.
                 CELOWO BEZ preCondition="managedHandler": moduł ma działać także dla żądań
                 proxowanych przez ARR i dla plików statycznych. -->
            <add name="PortalAuthUserHeader"
                 type="PortalAuthUserModule.AuthUserHeaderModule, PortalAuthUserModule" />
        </modules>
        <rewrite>
            <rules>
                <rule name="portal-api-proxy" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <serverVariables>
                        <!-- UWAGA: X-Auth-User NIE jest ustawiany tutaj. Reguły rewrite działają
                             w BeginRequest, PRZED uwierzytelnieniem, więc {LOGON_USER} jest w tym
                             miejscu zawsze pusty (diagnoza 2026-08-06). Login wpisuje moduł
                             PortalAuthUserHeader po etapie uwierzytelnienia. -->
                        <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
                    </serverVariables>
                    <action type="Rewrite" url="http://127.0.0.1:8080/api/{R:1}" />
                </rule>
            </rules>
        </rewrite>
        <security>
            <requestFiltering removeServerHeader="true" />
        </security>
    </system.webServer>
</configuration>
