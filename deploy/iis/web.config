<?xml version="1.0" encoding="UTF-8"?>
<!--
  Portal DZI - wewnętrzny portal kafelkowy departamentu DZI.
  Autor: Maciej Myśliwiec, 2026.
-->
<!--
  Konfiguracja witryny arimr-app.zszik.pl (katalog frontendu statycznego,
  D:\portal\frontend). Stan = serwer produkcyjny (zweryfikowany 2026-09-07).
  Wymaga: URL Rewrite + ARR (z włączonym proxy), roli ASP.NET 4.8,
  puli portal w trybie .NET v4.0 Integrated oraz modułu
  PortalAuthUserModule.dll (v3.0) w katalogu bin\.
  Szczegóły: deploy/iis/INSTRUKCJA-MODUL-WINDOWS-AUTH.md
-->
<configuration>
  <system.webServer>
    <!-- Moduł v3.0 (ADR-0006 + ADR-0008): po Windows Authentication wpisuje
         login do X-Auth-User i departament (pierwsze OU z AD) do X-Auth-Dept.
         Oba nagłówki przysłane przez klienta są bezwarunkowo nadpisywane/usuwane.
         CELOWO BEZ preCondition="managedHandler" - z nim moduł omijałby
         żądania proxowane przez ARR. -->
    <modules>
      <add name="PortalAuthUserHeader"
           type="PortalAuthUserModule.AuthUserHeaderModule, PortalAuthUserModule" />
    </modules>
    <rewrite>
      <rules>
        <rule name="portal-api-proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <serverVariables>
            <!-- LOGON_USER jest tu ZAWSZE PUSTY: reguły rewrite działają w etapie
                 BeginRequest, przed uwierzytelnieniem (diagnoza 2026-08-06).
                 Login wpisuje moduł PortalAuthUserHeader - patrz sekcja <modules>.
            <set name="HTTP_X_AUTH_USER" value="{LOGON_USER}" /> -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8080/api/{R:1}" />
        </rule>
        <!-- Strażnik /apps (ADR-0007): pliki modułów leżą POZA witryną
             (D:\portal\apps), wydaje je aplikacja po sprawdzeniu tile_permissions.
             Bez serverVariables: ARR dokłada X-Forwarded-For sam (potwierdzone
             w audycie 2026-09-08 - APP_OPEN ma adres stacji). -->
        <rule name="portal-apps-proxy" stopProcessing="true">
          <match url="^apps(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8080/apps{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
