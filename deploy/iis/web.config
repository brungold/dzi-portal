<?xml version="1.0" encoding="UTF-8"?>
<!--
  Portal DZI — wewnętrzny portal kafelkowy departamentu DZI.
  Autor: Maciej Myśliwiec, 2026.
-->
<!--
  Szablon web.config dla witryny portal.dzi.pl (katalog frontendu statycznego).
  Wymaga: URL Rewrite + ARR (z włączonym proxy) oraz dopisania HTTP_X_AUTH_USER
  i HTTP_X_FORWARDED_FOR do Allowed Server Variables - patrz README-IIS.md.
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="portal-api-proxy" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <serverVariables>
                        <!-- LOGON_USER = DOMENA\login po udanym Windows Authentication (Kerberos).
                             Ustawiane BEZWARUNKOWO: nadpisuje ewentualny X-Auth-User od klienta (anty-spoof). -->
                        <set name="HTTP_X_AUTH_USER" value="{LOGON_USER}" />
                        <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
                    </serverVariables>
                    <action type="Rewrite" url="http://127.0.0.1:8080/api/{R:1}" />
                </rule>
            </rules>
        </rewrite>
        <security>
            <requestFiltering removeServerHeader="true" />
        </security>
    </system.webServer>
</configuration>
