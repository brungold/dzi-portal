# Maven
target/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# System
.DS_Store
Thumbs.db

# Logi i lokalne nadpisania konfiguracji
*.log
application-local.yml

# Konfiguracja serwerowa z hasłem do bazy (szablon: deploy/declared/application-declared.yml.example)
config/application-declared.yml

# Moduły kafelków żyją WYŁĄCZNIE na serwerze (D:\portal\apps) — decyzja 2026-09-08.
# W repo zostaje tylko apps/README.md (procedura, układ katalogów, konwencje).
apps/*/
!apps/README.md
# Wyjątek: panel administracyjny jest częścią portalu (sprzężony z /api/admin w jarze) — ADR-0009
!apps/administracja/

# Siatka na dane, gdyby decyzja kiedyś się zmieniła (repo jest publiczne)
apps/**/*.csv
apps/**/*.xlsx
apps/**/*.xls
apps/**/*.json
!apps/**/*.przyklad.json
apps/*/data/
apps/*/dane*/
*_v[0-9]*.js
*_v[0-9]*.css
*_v[0-9]*.html
*_old.*
